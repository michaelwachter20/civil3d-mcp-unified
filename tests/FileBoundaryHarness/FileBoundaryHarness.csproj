<!--
  Project file of the .NET file-boundary harness (tests/FileBoundaryHarness/Program.cs). It links selected plugin
  source files that do not depend on Civil 3D, so the plugin's rules can be run and tested without Civil 3D.
  Add a Compile Include line here when the harness needs another plugin file. Run with npm run test:p2-boundaries.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Civil3D-MCP-Plugin\FileBoundary.cs" Link="FileBoundary.cs" />
    <Compile Include="..\..\Civil3D-MCP-Plugin\SharedFolder.cs" Link="SharedFolder.cs" />
    <Compile Include="..\..\Civil3D-MCP-Plugin\JsonRpcProtocol.cs" Link="JsonRpcProtocol.cs" />
    <Compile Include="..\..\Civil3D-MCP-Plugin\JobRegistry.cs" Link="JobRegistry.cs" />
    <Compile Include="..\..\Civil3D-MCP-Plugin\RpcTcpServer.cs" Link="RpcTcpServer.cs" />
    <Compile Include="..\..\Civil3D-MCP-Plugin\PointText.cs" Link="PointText.cs" />
    <Compile Include="..\..\Civil3D-MCP-Plugin\PipeMath.cs" Link="PipeMath.cs" />
    <Compile Include="..\..\Civil3D-MCP-Plugin\StationMath.cs" Link="StationMath.cs" />
    <Compile Include="..\..\Civil3D-MCP-Plugin\SightMath.cs" Link="SightMath.cs" />
    <Compile Include="..\..\Civil3D-MCP-Plugin\HostGuard.cs" Link="HostGuard.cs" />
    <Compile Include="..\..\Civil3D-MCP-Plugin\PointCreationRules.cs" Link="PointCreationRules.cs" />
    <Compile Include="..\..\Civil3D-MCP-Plugin\ScriptLoopGuard.cs" Link="ScriptLoopGuard.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.0.0" />
  </ItemGroup>
</Project>
